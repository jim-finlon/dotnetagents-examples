{
  "RoadAccess": {
    "Enabled": true,
    "AllowedService": "sample-read-api",
    "BaseUrl": "http://localhost:5000",
    "HealthPath": "/api/v1/whoami",
    "Auth": {
      "Scheme": "ApiKeyHeader",
      "HeaderName": "X-Api-Key",
      "ApiKeyEnvironmentVariable": "DNA_ROAD_ACCESS_API_KEY"
    },
    "TimeoutSeconds": 5,
    "Retry": {
      "MaxAttempts": 2,
      "BackoffMilliseconds": 250,
      "RetryStatusCodes": [ 408, 429, 500, 502, 503, 504 ]
    },
    "Fallback": {
      "Mode": "FailClosed",
      "PublicMessage": "DNA service is temporarily unavailable."
    },
    "Allowlist": [
      {
        "Service": "sample-read-api",
        "BaseUrl": "http://localhost:5000",
        "AllowedPaths": [
          "/health",
          "/api/v1/whoami"
        ],
        "Notes": "Lab validation target. Broader public story/status access should go through a scoped BFF or invoker-aware API."
      },
      {
        "Service": "dna-platform-gateway",
        "BaseUrl": "http://localhost:8080",
        "AllowedPaths": [
          "/v1/models",
          "/v1/chat/completions",
          "/v1/embeddings"
        ],
        "Notes": "Only for apps with a service-specific API key and model/data policy review."
      }
    ]
  }
}
