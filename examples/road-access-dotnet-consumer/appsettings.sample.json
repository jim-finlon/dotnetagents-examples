{
  "RoadAccess": {
    "Enabled": true,
    "AllowedService": "public-status-api",
    "BaseUrl": "https://api.dotnetagents.example",
    "HealthPath": "/health",
    "Auth": {
      "Scheme": "ApiKeyHeader",
      "HeaderName": "X-Api-Key",
      "ApiKeyEnvironmentVariable": "DNA_ROAD_ACCESS_API_KEY"
    },
    "TimeoutSeconds": 5,
    "Retry": {
      "MaxAttempts": 2,
      "BackoffMilliseconds": 250,
      "RetryStatusCodes": [ 408, 429, 500, 502, 503, 504 ]
    },
    "Fallback": {
      "Mode": "FailClosed",
      "PublicMessage": "DNA service is temporarily unavailable."
    },
    "Allowlist": [
      {
        "Service": "public-status-api",
        "BaseUrl": "https://api.dotnetagents.example",
        "AllowedPaths": [
          "/health",
          "/v1/status"
        ],
        "Notes": "Public placeholder target. Replace with your own public API or local dev endpoint."
      },
      {
        "Service": "model-gateway",
        "BaseUrl": "https://models.dotnetagents.example",
        "AllowedPaths": [
          "/v1/models",
          "/v1/chat/completions",
          "/v1/embeddings"
        ],
        "Notes": "Only for apps with a service-specific API key and model/data policy review."
      }
    ]
  }
}
