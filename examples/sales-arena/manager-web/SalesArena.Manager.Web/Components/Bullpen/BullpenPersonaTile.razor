@using SalesArena.Manager.Web.Models
@using SalesArena.Manager.Web.Services.Bullpen

<article class="sa-bullpen__tile" data-testid="bullpen-tile" data-persona="@Tile.PersonaId">
    <div class="sa-bullpen__avatar" aria-hidden="true">@Tile.AvatarGlyph</div>
    <div class="sa-bullpen__body">
        <header class="sa-bullpen__header">
            <h2 class="sa-bullpen__name" data-testid="bullpen-persona-name">@Tile.DisplayName</h2>
            <span class="sa-bullpen__state" data-testid="bullpen-activity">@ActivityLabel(Tile.Activity)</span>
        </header>
        <p class="sa-bullpen__thought" data-testid="bullpen-thought">@Tile.CurrentThought</p>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public BullpenTileModel Tile { get; set; } = default!;

    private static string ActivityLabel(FloorActivity activity) => activity switch
    {
        FloorActivity.Researching => "Researching",
        FloorActivity.Drafting => "Drafting",
        FloorActivity.Sending => "Sending",
        FloorActivity.Waiting => "Waiting",
        FloorActivity.InMeeting => "In meeting",
        _ => "Idle",
    };
}
