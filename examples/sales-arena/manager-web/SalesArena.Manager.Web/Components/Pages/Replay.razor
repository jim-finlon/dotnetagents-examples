@page "/replay"
@using SalesArena.Manager.Web.Services.Replay
@using SalesArena.Replay
@inject IReplayBrowserService ReplayBrowser
@inject NavigationManager Navigation

<PageTitle>Replay — Sales Arena</PageTitle>

<PageHeader Title="Replay browser"
            SubTitle="Browse past contests and deep-link into deal timelines." />

<PanelCard Title="Past contests" SubTitle="@($"{_contests.Count} on ledger")">
    @if (_isLoadingContests)
    {
        <p class="text-muted mb-0">Loading contests…</p>
    }
    else if (_loadError is not null)
    {
        <p class="text-danger mb-0">@_loadError</p>
    }
    else if (_contests.Count == 0)
    {
        <p class="text-muted mb-0">No completed contests in the ledger yet.</p>
    }
    else
    {
        <div class="sa-replay__contest-list">
            @foreach (var contest in _contests)
            {
                <button type="button"
                        class="sa-replay__contest @(_selectedContestId == contest.ContestId ? "is-active" : null)"
                        @onclick="() => SelectContest(contest.ContestId)">
                    <span class="sa-replay__contest-name">@contest.DisplayName</span>
                    <span class="sa-replay__contest-meta">
                        @contest.EndedAtUtc.ToLocalTime().ToString("g")
                        · @contest.DealCount deal@(contest.DealCount == 1 ? "" : "s")
                        @if (!string.IsNullOrWhiteSpace(contest.WinningPersona))
                        {
                            <text> · winner @contest.WinningPersona</text>
                        }
                    </span>
                </button>
            }
        </div>
    }
</PanelCard>

@if (_selectedContestId is not null)
{
    @if (_isLoadingReport)
    {
        <PanelCard Title="Report">
            <p class="text-muted mb-0">Generating replay…</p>
        </PanelCard>
    }
    else if (_report is not null)
    {
        @if (!string.IsNullOrWhiteSpace(LeadId) && _dealFocus is null && !_isLoadingReport)
        {
            <PanelCard Title="@($"Deal focus — {LeadId}")">
                <p class="text-muted mb-0">No ledger events for this lead in the selected contest.</p>
            </PanelCard>
        }

        @if (_dealFocus is not null)
        {
            <PanelCard Title="@($"Deal focus — {_dealFocus.LeadId}")"
                       SubTitle="@(_dealFocus.Persona is { } p ? $"Persona {p}" : "Ledger timeline")">
                @if (_dealFocus.Highlights.Count > 0)
                {
                    <ul class="sa-replay__highlights">
                        @foreach (var highlight in _dealFocus.Highlights)
                        {
                            <li>
                                <strong>@highlight.Headline</strong>
                                @if (highlight.ValueUsd is { } v)
                                {
                                    <span class="text-muted"> · @($"${v:N0}")</span>
                                }
                            </li>
                        }
                    </ul>
                }
                <ul class="sa-replay__timeline">
                    @foreach (var entry in _dealFocus.Timeline)
                    {
                        <li>
                            <span class="sa-replay__timeline-time">@entry.OccurredAtUtc.ToLocalTime().ToString("g")</span>
                            <span class="sa-replay__timeline-kind">@entry.Kind</span>
                            <span>@entry.Summary</span>
                        </li>
                    }
                </ul>
                <p class="mb-0">
                    <button type="button" class="sa-replay__clear-link" @onclick="ClearLeadFocus">Clear deal focus</button>
                </p>
            </PanelCard>
        }

        <PanelCard Title="@ReportPanelTitle"
                   SubTitle="@($"Generated {_report.GeneratedAtUtc.ToLocalTime():g}")">
            <div class="sa-replay__sections" role="tablist" aria-label="Replay sections">
                @foreach (var section in _report.Sections)
                {
                    <button type="button"
                            role="tab"
                            class="sa-replay__section-chip @(_activeSection == section.Kind ? "is-active" : null)"
                            aria-selected="@(_activeSection == section.Kind)"
                            @onclick="() => SelectSection(section.Kind)">
                        @SectionLabel(section.Kind)
                    </button>
                }
            </div>

            @if (_activeSectionMarkdown is not null)
            {
                <pre class="sa-replay__markdown" aria-live="polite">@_activeSectionMarkdown</pre>
            }
        </PanelCard>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "contestId")]
    public string? ContestId { get; set; }

    [SupplyParameterFromQuery(Name = "leadId")]
    public string? LeadId { get; set; }

    private IReadOnlyList<ReplayContestSummary> _contests = [];
    private string? _selectedContestId;
    private ReplayReport? _report;
    private ReplayDealFocus? _dealFocus;
    private ReplaySectionKind? _activeSection;
    private string? _activeSectionMarkdown;
    private bool _isLoadingContests = true;
    private bool _isLoadingReport;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _contests = await ReplayBrowser.ListContestsAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoadingContests = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isLoadingContests)
        {
            return;
        }

        var contestId = !string.IsNullOrWhiteSpace(ContestId)
            ? ContestId
            : _contests.FirstOrDefault()?.ContestId;

        if (string.IsNullOrWhiteSpace(contestId))
        {
            return;
        }

        if (!string.Equals(contestId, _selectedContestId, StringComparison.Ordinal))
        {
            await SelectContestAsync(contestId);
        }
        else if (!string.IsNullOrWhiteSpace(LeadId))
        {
            await LoadDealFocusAsync(LeadId);
        }
    }

    private void SelectContest(string contestId)
    {
        LeadId = null;
        _dealFocus = null;
        Navigation.NavigateTo($"/replay?contestId={Uri.EscapeDataString(contestId)}", replace: true);
    }

    private async Task SelectContestAsync(string contestId)
    {
        _selectedContestId = contestId;
        _isLoadingReport = true;
        _loadError = null;
        _report = null;
        _activeSection = null;
        _activeSectionMarkdown = null;

        try
        {
            _report = await ReplayBrowser.GetReportAsync(contestId);
            var initialSection = _report.Sections.FirstOrDefault();
            if (initialSection is not null)
            {
                SelectSection(initialSection.Kind);
            }

            if (!string.IsNullOrWhiteSpace(LeadId))
            {
                await LoadDealFocusAsync(LeadId);
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoadingReport = false;
        }
    }

    private async Task LoadDealFocusAsync(string leadId)
    {
        if (_selectedContestId is null || _report is null)
        {
            return;
        }

        _dealFocus = await ReplayBrowser.GetDealFocusAsync(_selectedContestId, leadId, _report);
        var section = ReplayBrowserQuery.SectionForLead(_report.Sections, leadId);
        if (section is not null)
        {
            SelectSection(section.Kind);
        }
    }

    private void SelectSection(ReplaySectionKind kind)
    {
        _activeSection = kind;
        _activeSectionMarkdown = _report?.Sections.FirstOrDefault(s => s.Kind == kind)?.Markdown;
    }

    private void ClearLeadFocus()
    {
        LeadId = null;
        _dealFocus = null;
        if (_selectedContestId is not null)
        {
            Navigation.NavigateTo($"/replay?contestId={Uri.EscapeDataString(_selectedContestId)}", replace: true);
        }
    }

    private string ReportPanelTitle =>
        _report?.Sections.FirstOrDefault()?.Title ?? "Replay report";

    private static string SectionLabel(ReplaySectionKind kind) => kind switch
    {
        ReplaySectionKind.Leaderboard => "Leaderboard",
        ReplaySectionKind.PersonaDealLog => "Deal logs",
        ReplaySectionKind.SteakKnivesShowcase => "Steak knives",
        ReplaySectionKind.ClosestCall => "Closest call",
        ReplaySectionKind.BestComeback => "Comeback",
        ReplaySectionKind.MvpTouch => "MVP touch",
        ReplaySectionKind.Roast => "Roast",
        _ => kind.ToString(),
    };
}
