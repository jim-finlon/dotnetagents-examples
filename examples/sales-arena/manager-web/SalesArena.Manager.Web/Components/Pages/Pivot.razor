@page "/pivot"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using SalesArena.Manager.Web.Services.ChannelPivot
@attribute [Authorize]
@inject IChannelPivotService PivotService

<PageTitle>Channel pivot</PageTitle>

<PageHeader Title="Channel effectiveness"
            SubTitle="Reply and close rates by channel × industry (ledger aggregates)" />

<section class="sa-pivot" data-testid="pivot-dashboard">
    <div class="sa-pivot__toolbar">
        <fieldset class="sa-pivot__metric-toggle">
            <legend>Metric</legend>
            <button type="button"
                    class="sa-pivot__toggle @( _metricMode == ChannelPivotMetricMode.ReplyRate ? "is-active" : null)"
                    data-testid="metric-reply-rate"
                    @onclick="() => SetMetric(ChannelPivotMetricMode.ReplyRate)">
                Reply rate
            </button>
            <button type="button"
                    class="sa-pivot__toggle @( _metricMode == ChannelPivotMetricMode.CloseRate ? "is-active" : null)"
                    data-testid="metric-close-rate"
                    @onclick="() => SetMetric(ChannelPivotMetricMode.CloseRate)">
                Close rate
            </button>
        </fieldset>
        <button type="button" class="sa-pivot__export" data-testid="export-csv" @onclick="ExportCsv">
            Export CSV
        </button>
        @if (!string.IsNullOrEmpty(_csvExport))
        {
            <a class="sa-pivot__download"
               data-testid="csv-download-link"
               download="channel-pivot.csv"
               href="@CsvDataUri">Download file</a>
        }
    </div>

    @if (_snapshot is null)
    {
        <p data-testid="pivot-loading">Loading pivot…</p>
    }
    else if (_snapshot.Cells.Count == 0)
    {
        <p data-testid="pivot-empty">No touch events yet for this contest.</p>
    }
    else
    {
        <div class="sa-pivot__heatmap-wrap">
            <table class="sa-pivot__heatmap" aria-label="Channel by industry heatmap">
                <thead>
                    <tr>
                        <th scope="col">Channel \ Industry</th>
                        @foreach (var industry in _snapshot.Industries)
                        {
                            <th scope="col">@industry</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var channel in _snapshot.Channels)
                    {
                        <tr>
                            <th scope="row">@channel</th>
                            @foreach (var industry in _snapshot.Industries)
                            {
                                var cell = FindCell(channel, industry);
                                if (cell is null)
                                {
                                    <td class="sa-pivot__cell sa-pivot__cell--empty">—</td>
                                }
                                else
                                {
                                    var value = MetricValue(cell);
                                    var selected = _selectedChannel == channel && _selectedIndustry == industry;
                                    <td>
                                        <button type="button"
                                                class="sa-pivot__cell @(selected ? "is-selected" : null) @(cell.LowSample ? "is-low-sample" : null)"
                                                style="@CellStyle(value)"
                                                data-testid="heatmap-cell"
                                                title="@CellTitle(cell)"
                                                @onclick="() => SelectCell(channel, industry)">
                                            <span class="sa-pivot__cell-value">@FormatRate(value)</span>
                                            <span class="sa-pivot__cell-n">n=@cell.TouchCount</span>
                                        </button>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_selectedCell is not null)
        {
            <section class="sa-pivot__drilldown" data-testid="pivot-drilldown">
                <h2>Persona drilldown: @_selectedChannel × @_selectedIndustry</h2>
                @if (_selectedCell.LowSample)
                {
                    <p class="sa-pivot__warning" data-testid="low-sample-warning">
                        Sample size &lt; 5 — rates may be misleading.
                    </p>
                }
                <table class="sa-pivot__persona-table">
                    <thead>
                        <tr>
                            <th>Persona</th>
                            <th>Touches</th>
                            <th>Inbounds</th>
                            <th>Closes</th>
                            <th>Reply</th>
                            <th>Close</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _selectedCell.PersonaRows)
                        {
                            <tr data-testid="persona-row">
                                <td>@row.Persona</td>
                                <td>@row.TouchCount</td>
                                <td>@row.InboundCount</td>
                                <td>@row.CloseCount</td>
                                <td>@FormatRate(row.ReplyRate)</td>
                                <td>@FormatRate(row.CloseRate)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
</section>

@code {
    private ChannelPivotSnapshot? _snapshot;
    private ChannelPivotMetricMode _metricMode = ChannelPivotMetricMode.ReplyRate;
    private string? _selectedChannel;
    private string? _selectedIndustry;
    private ChannelPivotCell? _selectedCell;
    private string? _csvExport;

    private string CsvDataUri =>
        $"data:text/csv;charset=utf-8,{Uri.EscapeDataString(_csvExport ?? string.Empty)}";

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await PivotService.BuildSnapshotAsync().ConfigureAwait(false);
    }

    private void SetMetric(ChannelPivotMetricMode mode)
    {
        _metricMode = mode;
    }

    private void SelectCell(string channel, string industry)
    {
        _selectedChannel = channel;
        _selectedIndustry = industry;
        _selectedCell = FindCell(channel, industry);
    }

    private void ExportCsv()
    {
        if (_snapshot is null)
        {
            return;
        }

        _csvExport = PivotService.ExportCsv(_snapshot, _metricMode);
    }

    private ChannelPivotCell? FindCell(string channel, string industry) =>
        _snapshot?.Cells.FirstOrDefault(c =>
            string.Equals(c.Channel, channel, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(c.Industry, industry, StringComparison.OrdinalIgnoreCase));

    private double MetricValue(ChannelPivotCell cell) =>
        _metricMode == ChannelPivotMetricMode.CloseRate ? cell.CloseRate : cell.ReplyRate;

    private static string FormatRate(double rate) =>
        rate.ToString("P0", CultureInfo.InvariantCulture);

    private static string CellTitle(ChannelPivotCell cell) =>
        $"Touches {cell.TouchCount}, inbounds {cell.InboundCount}, closes {cell.CloseCount}";

    private static string CellStyle(double value)
    {
        var clamped = Math.Clamp(value, 0, 1);
        var red = (int)(255 * (1 - clamped));
        var green = (int)(255 * clamped);
        return $"background-color: rgb({red},{green},80); color: {(clamped > 0.55 ? "#111" : "#fff")};";
    }
}
