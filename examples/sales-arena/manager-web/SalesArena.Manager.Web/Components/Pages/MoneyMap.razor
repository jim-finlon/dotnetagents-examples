@page "/money-map"
@using Microsoft.AspNetCore.Authorization
@using SalesArena.Manager.Web.Components.Map
@using SalesArena.Manager.Web.Services
@using SalesArena.Manager.Web.Services.MoneyMap
@attribute [Authorize]
@implements IAsyncDisposable
@inject ArenaLiveFeed LiveFeed
@inject MoneyMapState MapState

<PageTitle>Money Map — Sales Arena</PageTitle>

<PageHeader Title="Money Map"
            SubTitle="Geographic revenue — won deals as regional pins from the live ledger" />

<section class="sa-money-map-page" data-testid="money-map-page">
    <MoneyMapWidget Model="@MapState.Snapshot" />
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        MapState.StateChanged += OnMapStateChanged;

        try
        {
            await LiveFeed.EnsureConnectedAsync().ConfigureAwait(false);
        }
        catch
        {
            // Renders empty map when hub unavailable (bUnit / smoke).
        }

        MapState.WireToFeed(LiveFeed);
    }

    private void OnMapStateChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        MapState.StateChanged -= OnMapStateChanged;
        MapState.UnwireFromFeed(LiveFeed);
    }
}
