@page "/gallery/{Slug}"
@using Microsoft.AspNetCore.Authorization
@using SalesArena.Manager.Web.Services.Gallery
@attribute [Authorize]
@inject ICommunityPersonaGalleryCatalog Catalog
@inject NavigationManager Navigation

<PageTitle>@( _detail?.Card.DisplayName ?? "Persona")</PageTitle>

<section class="sa-gallery-detail" data-testid="gallery-detail">
    @if (_isLoading)
    {
        <p data-testid="gallery-detail-loading">Loading persona…</p>
    }
    else if (_notFound)
    {
        <p data-testid="gallery-detail-missing">Persona pack not found.</p>
        <a href="/gallery" class="sa-gallery-detail__back">Back to gallery</a>
    }
    else if (_detail is not null)
    {
        <a href="/gallery" class="sa-gallery-detail__back" data-testid="gallery-back">← Gallery</a>
        <header class="sa-gallery-detail__header">
            <img class="sa-gallery__avatar" src="@_detail.Card.AvatarUrl" alt="" width="64" height="64" />
            <div>
                <h1>@GalleryTextSanitizer.Escape(_detail.Card.DisplayName)</h1>
                <CoachOverlayBadge Persona="@Slug" />
                <a href="/coach/@Slug" class="sa-gallery__coach-link" data-testid="coach-link">Coach mode</a>
                <p class="sa-gallery__author">by @GalleryTextSanitizer.Escape(_detail.Card.Author)</p>
                <ul class="sa-gallery__stats">
                    <li>ELO <strong>@_detail.Card.Elo</strong></li>
                    <li>Contests <strong>@_detail.Card.ContestsRun</strong></li>
                    <li>Wins <strong>@_detail.Card.Wins</strong></li>
                    <li>Deals <strong>@_detail.Card.DealsClosed</strong></li>
                </ul>
            </div>
        </header>

        <article class="sa-gallery-detail__bio">
            <h2>Bio</h2>
            <p data-testid="gallery-bio">@GalleryTextSanitizer.Escape(GalleryTextSanitizer.ToPlainExcerpt(_detail.BioMarkdown, 2000))</p>
        </article>

        <article class="sa-gallery-detail__contests">
            <h2>Recent contests</h2>
            <ul data-testid="gallery-recent-contests">
                @foreach (var contest in _detail.RecentContests)
                {
                    <li>
                        <strong>@GalleryTextSanitizer.Escape(contest.ContestName)</strong>
                        — @GalleryTextSanitizer.Escape(contest.Outcome)
                        <span class="text-muted">(@contest.EndedAtUtc.ToString("u"))</span>
                    </li>
                }
            </ul>
        </article>

        <article class="sa-gallery-detail__prompt">
            <h2>Prompt preview (sanitized)</h2>
            <pre data-testid="gallery-prompt-preview">@GalleryTextSanitizer.Escape(GalleryTextSanitizer.ToPromptPreview(_detail.PromptPreview))</pre>
        </article>

        <button type="button"
                class="sa-gallery__challenge"
                data-testid="challenge-button"
                @onclick="Challenge">
            Challenge this persona
        </button>
        @if (!string.IsNullOrEmpty(_challengeNotice))
        {
            <p class="sa-gallery__notice" data-testid="challenge-notice">@_challengeNotice</p>
        }
    }
</section>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private bool _isLoading = true;
    private bool _notFound;
    private CommunityPersonaDetail? _detail;
    private string? _challengeNotice;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _notFound = false;
        _detail = null;
        try
        {
            _detail = await Catalog.GetDetailAsync(Slug).ConfigureAwait(false);
            _notFound = _detail is null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Challenge()
    {
        var queued = Catalog.QueueChallenge(Slug);
        _challengeNotice = queued is null
            ? "Could not queue challenge."
            : $"Challenge queued for {GalleryTextSanitizer.Escape(queued)}.";
    }
}
