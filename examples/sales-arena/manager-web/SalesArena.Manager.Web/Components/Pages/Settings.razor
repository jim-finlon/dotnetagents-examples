@page "/settings"
@page "/settings/contest"
@using System.ComponentModel.DataAnnotations
@using SalesArena.Manager.Web.Services.ContestSettings
@inject IContestLifecycleHost ContestLifecycle

<PageTitle>Contest settings</PageTitle>

<div class="sa-settings">
    <header class="sa-settings__header">
        <h1 class="sa-settings__title">Contest settings</h1>
        <p class="sa-settings__subtitle">
            Configure personas, prize tier, scoring metric, and arena rules before starting a run.
        </p>
        <div class="sa-settings__status" data-testid="contest-run-state">
            <span class="sa-settings__status-label">Run state</span>
            <strong>@ContestLifecycle.State</strong>
            @if (!string.IsNullOrWhiteSpace(ContestLifecycle.LastStatusMessage))
            {
                <span class="sa-settings__status-detail">@ContestLifecycle.LastStatusMessage</span>
            }
        </div>
    </header>

    @if (_contestIsActive)
    {
        <div class="sa-settings__banner sa-settings__banner--warn" role="alert" data-testid="active-contest-banner">
            A contest is <strong>Active</strong>. Pause it on the floor view before changing settings or starting a new run.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
    {
        <div class="sa-settings__banner @(_feedbackIsError ? "sa-settings__banner--error" : "sa-settings__banner--ok")"
             role="status"
             data-testid="settings-feedback">
            @_feedbackMessage
        </div>
    }

    <EditForm Model="_form" OnValidSubmit="HandleStartContestAsync" class="sa-settings__form">
        <DataAnnotationsValidator />
        <ValidationSummary class="sa-settings__validation" data-testid="settings-validation-summary" />

        @if (!string.IsNullOrWhiteSpace(_personaError))
        {
            <p class="sa-settings__field-error" data-testid="persona-validation-error">@_personaError</p>
        }

        <section class="sa-settings__section" aria-labelledby="contest-core-heading">
            <h2 id="contest-core-heading" class="sa-settings__section-title">Contest</h2>
            <div class="sa-settings__grid">
                <div class="sa-settings__field">
                    <label for="contest-name">Contest name</label>
                    <InputText id="contest-name"
                               class="sa-settings__input"
                               @bind-Value="_form.ContestName"
                               disabled="@_contestIsActive" />
                    <ValidationMessage For="@(() => _form.ContestName)" />
                </div>
                <div class="sa-settings__field">
                    <label for="duration-hours">Duration (hours)</label>
                    <InputNumber id="duration-hours"
                                 class="sa-settings__input"
                                 @bind-Value="_form.DurationHours"
                                 disabled="@_contestIsActive" />
                    <ValidationMessage For="@(() => _form.DurationHours)" />
                </div>
                <div class="sa-settings__field">
                    <label for="lead-pack">Lead pack</label>
                    <InputSelect id="lead-pack"
                                 class="sa-settings__input"
                                 @bind-Value="_form.LeadPackId"
                                 disabled="@_contestIsActive">
                        @foreach (var pack in LeadPackOptions.All)
                        {
                            <option value="@pack.Id">@pack.Label</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </section>

        <section class="sa-settings__section" aria-labelledby="personas-heading">
            <h2 id="personas-heading" class="sa-settings__section-title">Personas</h2>
            <p class="sa-settings__hint">Select at least one base persona for the contest roster.</p>
            <div class="sa-settings__checkbox-grid" data-testid="persona-checkboxes">
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.PersonaRomano" disabled="@_contestIsActive" />
                    Romano
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.PersonaMoss" disabled="@_contestIsActive" />
                    Moss
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.PersonaAaronow" disabled="@_contestIsActive" />
                    Aaronow
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.PersonaLevene" disabled="@_contestIsActive" />
                    Levene
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.PersonaWilliamson" disabled="@_contestIsActive" />
                    Williamson
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.PersonaHarris" disabled="@_contestIsActive" />
                    Harris
                </label>
            </div>
        </section>

        <section class="sa-settings__section" aria-labelledby="scoring-heading">
            <h2 id="scoring-heading" class="sa-settings__section-title">Prize tier &amp; scoring</h2>
            <div class="sa-settings__grid">
                <div class="sa-settings__field">
                    <label for="prize-tier">Prize tier</label>
                    <InputSelect id="prize-tier"
                                 class="sa-settings__input"
                                 @bind-Value="_form.PrizeTierPreset"
                                 disabled="@_contestIsActive">
                        @foreach (var tier in PrizeTierPresets.Options)
                        {
                            <option value="@tier.Id">@tier.Label</option>
                        }
                    </InputSelect>
                </div>
                <div class="sa-settings__field">
                    <label for="scoring-metric">Scoring metric</label>
                    <InputSelect id="scoring-metric"
                                 class="sa-settings__input"
                                 @bind-Value="_form.ScoringMetricId"
                                 disabled="@_contestIsActive">
                        @foreach (var metric in ContestSettingsFormModel.ScoringMetricOptions)
                        {
                            <option value="@metric.Id">@metric.Label</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </section>

        <section class="sa-settings__section" aria-labelledby="rules-heading">
            <h2 id="rules-heading" class="sa-settings__section-title">Arena rules</h2>
            <div class="sa-settings__checkbox-grid" data-testid="rule-toggles">
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.RuleNoDoubleTouch" disabled="@_contestIsActive" />
                    No double-touch (one persona per lead)
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.RuleGlengarryDrip" disabled="@_contestIsActive" />
                    Glengarry drip pacing
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.RuleBellOnClose" disabled="@_contestIsActive" />
                    Bell on close
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.RuleNarrationCues" disabled="@_contestIsActive" />
                    Narration cues
                </label>
                <label class="sa-settings__checkbox">
                    <InputCheckbox @bind-Value="_form.RuleBusinessHoursOnly" disabled="@_contestIsActive" />
                    Business hours only
                </label>
            </div>
        </section>

        <footer class="sa-settings__actions">
            <button type="submit"
                    class="sa-settings__primary"
                    data-testid="start-contest-button"
                    disabled="@_contestIsActive">
                Start contest
            </button>
            @if (_contestIsActive)
            {
                <p class="sa-settings__hint" data-testid="pause-first-hint">
                    Pause the active contest before submitting new settings.
                </p>
            }
        </footer>
    </EditForm>
</div>

@code {
    private readonly ContestSettingsFormModel _form = new();
    private string? _feedbackMessage;
    private bool _feedbackIsError;
    private string? _personaError;

    private bool _contestIsActive => ContestLifecycle.State == ContestRunState.Active;

    private async Task HandleStartContestAsync()
    {
        _feedbackMessage = null;
        _personaError = null;

        if (_contestIsActive)
        {
            _feedbackIsError = true;
            _feedbackMessage = "Contest is active. Pause it before starting a new configuration.";
            return;
        }

        if (!ContestSettingsValidation.HasEnabledPersona(_form))
        {
            _personaError = ContestSettingsValidation.PersonaRequiredMessage;
            return;
        }

        var draft = _form.ToDraft();
        var initResult = await ContestLifecycle.InitAsync(draft);
        if (!initResult.Succeeded)
        {
            _feedbackIsError = true;
            _feedbackMessage = initResult.Message;
            return;
        }

        var startResult = await ContestLifecycle.StartAsync();
        _feedbackIsError = !startResult.Succeeded;
        _feedbackMessage = startResult.Message;
    }
}
