@using SalesArena.Manager.Web.Services.Coach
@implements IDisposable
@inject ICoachModeService CoachMode

@if (_remaining is int touches)
{
    <span class="sa-coach-badge" data-testid="coach-overlay-badge" title="Active halftime speech overlay">
        Coach · @touches touch@(touches == 1 ? "" : "es") left
    </span>
}

@code {
    [Parameter, EditorRequired]
    public string Persona { get; set; } = "";

    private int? _remaining;
    private Timer? _timer;

    protected override void OnParametersSet()
    {
        Refresh();
    }

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => InvokeAsync(Refresh), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
    }

    private void Refresh()
    {
        var overlay = CoachMode.GetActive(Persona);
        var next = overlay?.IsActive == true ? overlay.RemainingTouches : (int?)null;
        if (_remaining != next)
        {
            _remaining = next;
            StateHasChanged();
        }
    }

    public void Dispose() => _timer?.Dispose();
}
