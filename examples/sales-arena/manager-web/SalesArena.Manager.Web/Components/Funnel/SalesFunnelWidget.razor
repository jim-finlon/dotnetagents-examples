@using SalesArena.Manager.Web.Services.Pipeline
@inject PipelineFunnelState FunnelState
@implements IDisposable

<div class="sa-pipeline__viz" data-testid="pipeline-funnel" aria-label="Sales funnel visualization">
    <svg class="sa-pipeline__svg" viewBox="0 0 420 520" role="img" aria-hidden="true">
        @{
            var stages = FunnelState.Stages;
            var layerHeight = 52f;
            var topWidth = 360f;
            var bottomWidth = 120f;
            var total = Math.Max(1, stages.Count - 1);
        }
        @for (var i = 0; i < stages.Count; i++)
        {
            var t0 = (float)i / total;
            var t1 = (float)(i + 1) / total;
            var w0 = topWidth - (topWidth - bottomWidth) * t0;
            var w1 = topWidth - (topWidth - bottomWidth) * t1;
            var y0 = i * layerHeight;
            var y1 = y0 + layerHeight - 4;
            var x0 = (420f - w0) / 2f;
            var x1 = (420f - w1) / 2f;
            <polygon class="sa-pipeline__stage"
                     points="@($"{x0},{y0} {x0 + w0},{y0} {x1 + w1},{y1} {x1},{y1}")"
                     data-testid="pipeline-stage" />
        }
    </svg>

    <ol class="sa-pipeline__legend">
        @foreach (var stage in FunnelState.Stages)
        {
            <li class="sa-pipeline__legend-row" data-testid="pipeline-stage">
                <span class="sa-pipeline__legend-stage">@stage.Stage</span>
                <span class="sa-pipeline__legend-meta">@stage.Count active · @stage.RecentTransitions recent</span>
            </li>
        }
    </ol>

    <div class="sa-pipeline__avatars" aria-label="Personas by stage">
        @foreach (var stage in FunnelState.Stages)
        {
            <div class="sa-pipeline__avatar-row" data-testid="pipeline-avatar-row">
                <span class="sa-pipeline__avatar-stage">@stage.Stage</span>
                @foreach (var marker in stage.Personas)
                {
                    <span class="sa-pipeline__avatar" data-testid="pipeline-persona" title="@marker.Persona">@Initials(marker.Persona)</span>
                }
            </div>
        }
    </div>

    <div class="sa-pipeline__particles" aria-hidden="true">
        @foreach (var particle in FunnelState.ActiveParticles)
        {
            <span class="sa-pipeline__particle">$@particle.ValueUsd.ToString("N0")</span>
        }
    </div>
</div>

@code {
    protected override void OnInitialized() => FunnelState.StateChanged += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private static string Initials(string persona) =>
        string.IsNullOrWhiteSpace(persona)
            ? "?"
            : persona.Length >= 2
                ? persona[..2].ToUpperInvariant()
                : persona.ToUpperInvariant();

    public void Dispose() => FunnelState.StateChanged -= OnStateChanged;
}
