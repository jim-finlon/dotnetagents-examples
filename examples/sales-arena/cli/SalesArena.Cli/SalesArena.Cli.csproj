<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SalesArena.Cli</RootNamespace>
    <AssemblyName>SalesArena.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dna-arena</ToolCommandName>
    <PackageId>SalesArena.Cli</PackageId>
    <Description>dna-arena CLI for the DNA Sales Arena (story 6122c6f7 / SA-04-03). Provides init / contest / floor / bell / replay subcommands.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../orchestrator/SalesArena.Orchestrator.csproj" />
    <ProjectReference Include="../../replay/SalesArena.Replay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <DnaReference Include="DotNetAgents.Core" />
  </ItemGroup>

</Project>
