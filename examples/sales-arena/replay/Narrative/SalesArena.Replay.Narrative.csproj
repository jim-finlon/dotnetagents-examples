<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SalesArena.Replay.Narrative</RootNamespace>
    <AssemblyName>SalesArena.Replay.Narrative</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Copy the operator-editable prompt template next to the assembly so
         NarrativeRewriter.LoadDefaultPrompt() can find it at runtime. The
         canonical source lives in examples/sales-arena/replay/templates/. -->
    <None Include="..\templates\narrative-rewriter.prompt.md" Link="templates\narrative-rewriter.prompt.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
