<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SalesArena.Replay</RootNamespace>
    <AssemblyName>SalesArena.Replay</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../orchestrator/SalesArena.Orchestrator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="templates/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Podcast/ is owned by SalesArena.Replay.Podcast; keep its sources out of this assembly. -->
    <Compile Remove="Podcast/**" />
    <Content Remove="Podcast/**" />
    <None Remove="Podcast/**" />
    <EmbeddedResource Remove="Podcast/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Counterfactual/ is owned by SalesArena.Replay.Counterfactual; same carve-out as Podcast/. -->
    <Compile Remove="Counterfactual/**" />
    <Content Remove="Counterfactual/**" />
    <None Remove="Counterfactual/**" />
    <EmbeddedResource Remove="Counterfactual/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- TraceExplorer/ is owned by SalesArena.Replay.TraceExplorer; same carve-out. -->
    <Compile Remove="TraceExplorer/**" />
    <Content Remove="TraceExplorer/**" />
    <None Remove="TraceExplorer/**" />
    <EmbeddedResource Remove="TraceExplorer/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Narrative/ is owned by SalesArena.Replay.Narrative; same carve-out. -->
    <Compile Remove="Narrative/**" />
    <Content Remove="Narrative/**" />
    <None Remove="Narrative/**" />
    <EmbeddedResource Remove="Narrative/**" />
  </ItemGroup>
</Project>
