<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SalesArena.Orchestrator</RootNamespace>
    <AssemblyName>SalesArena.Orchestrator</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <DnaReference Include="DotNetAgents.Agents.BehaviorTrees" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Narration/scripts/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/Narration/scripts</PackagePath>
    </Content>
  </ItemGroup>
</Project>
