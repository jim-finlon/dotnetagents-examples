{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dna://sales-arena/lead-pack.v2",
  "title": "DNA Sales Arena Lead Pack v2",
  "description": "Renewal-aware synthetic customer data for the DNA Sales Arena. Extends v1 with MRR, renewal dates, churn risk, and expansion signals. v1 packs remain valid when loaded with version 'v1'.",
  "type": "object",
  "required": ["version", "name", "description", "synthetic", "leads"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "v2",
      "description": "Lead-pack schema version. Use v2 for renewal-focused contest packs (SA-06-03)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "leads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/definitions/leadV2" }
    }
  },
  "definitions": {
    "leadV2": {
      "type": "object",
      "required": ["id", "tier", "company", "customer_tier", "mrr", "renewal_date", "churn_risk_score"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L-[0-9]{4,}$"
        },
        "tier": {
          "enum": ["glengarry", "cold"],
          "description": "Pool assignment tier (unchanged from v1)."
        },
        "company": { "$ref": "#/definitions/company" },
        "contact": { "$ref": "#/definitions/contact" },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/definitions/signal" }
        },
        "notes": { "type": "string" },
        "customer_tier": {
          "enum": ["starter", "growth", "enterprise"],
          "description": "Existing-customer commercial tier for renewal contests."
        },
        "mrr": {
          "type": "number",
          "minimum": 0,
          "description": "Monthly recurring revenue (USD, fictional)."
        },
        "renewal_date": {
          "type": "string",
          "format": "date",
          "description": "Contract renewal date (ISO-8601 date)."
        },
        "churn_risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = stable, 1 = imminent churn risk."
        },
        "expansion_signal": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": "Upsell / expansion hints (usage spikes, seat growth, feature requests)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "glengarry" } } },
          "then": { "required": ["contact", "signals"] }
        }
      ]
    },
    "company": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "industry": {
          "enum": [
            "pharma", "fintech", "manufacturing", "healthcare", "ecommerce",
            "education", "hospitality", "agritech", "saas", "logistics",
            "media", "construction", "energy", "nonprofit", "other"
          ]
        },
        "size": { "enum": ["smb", "mid-market", "enterprise"] },
        "region": { "type": "string" },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.(example|test|invalid)$"
        },
        "headcount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string" },
        "email": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+-]+@[a-z0-9.-]+\\.(example|test|invalid)$"
        },
        "phone": {
          "type": "string",
          "pattern": "^555-[0-9]{4}$"
        }
      }
    },
    "signal": {
      "type": "object",
      "required": ["kind", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "news", "hiring", "content_engagement", "mutual_connection",
            "press_release", "leadership_change", "funding",
            "product_launch", "expansion", "compliance_event"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "timestampUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
